{
  "name": "@mixedrays/keyrove",
  "version": "0.0.0",
  "description": "Framework-agnostic arrow-key navigation for lists and grids, driven by data-* attributes.",
  "keywords": [
    "keyboard",
    "keyboard-navigation",
    "arrow-keys",
    "roving-tabindex",
    "accessibility",
    "a11y",
    "focus",
    "list",
    "grid"
  ],
  "license": "MIT",
  "author": "mixedrays <mixedrays@gmail.com>",
  "homepage": "https://github.com/mixedrays/keyrove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedrays/keyrove.git",
    "directory": "packages/keyrove"
  },
  "bugs": {
    "url": "https://github.com/mixedrays/keyrove/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^29.1.1",
    "release-it": "^21.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
