{
  "name": "@mixedrays/keyrove/bench",
  "version": "1.0.0",
  "private": true,
  "description": "Browser benchmark for keyrove's keydown handling, with a UI to run it and to compare runs across versions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mixedrays/keyrove build && vite",
    "build": "vite build",
    "start": "pnpm --filter @mixedrays/keyrove build && vite build && vite preview --open",
    "headless": "node scripts/run.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mixedrays/keyrove": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "lucide": "^1.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
